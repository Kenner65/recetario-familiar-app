# URL pública de la API desplegada en Vercel.
# Es la ÚNICA variable que la app conoce. No es un secreto: queda dentro del APK.
#
# Copia este archivo a `.env` y pon la URL real de tu API:
#   EXPO_PUBLIC_API_URL=https://<tu-proyecto>.vercel.app
#
# NUNCA pongas aquí claves de Firebase, tokens de Blob ni credenciales.
# Todo lo secreto vive únicamente en las variables de entorno de Vercel.

EXPO_PUBLIC_API_URL=
