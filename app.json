{
  "expo": {
    "name": "Recetario Familiar",
    "slug": "recetario-familiar-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "recetariofamiliarapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.recetariofamiliar.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8F1E7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.recetariofamiliar.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F1E7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "La app usa la cámara para tomar una foto de tu plato terminado."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "La app accede a tus fotos para elegir la imagen del plato.",
          "cameraPermission": "La app usa la cámara para tomar una foto de tu plato terminado."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
